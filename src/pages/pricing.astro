---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import TryButton from '../components/TryButton.astro';
import { mailto } from '../lib/url';
import { PRODUCT_NAME, PRICES, FLAGS, FEATURE_STATUS } from '../config/brand';
import { pricingFaq } from '../data/faq';

type Cell = string;
const rows: { f: string; key: string; c: [Cell, Cell, Cell] }[] = [
  { f: 'Racks', key: 'fourRacks', c: ['2', '2', '4'] },
  { f: '3D rack from Excel / CSV', key: 'import3d', c: ['✓', '✓', '✓'] },
  { f: 'Power, Heat, Network, Compute views', key: 'views', c: ['✓', '✓', '✓'] },
  { f: 'Power and network diagrams', key: 'diagrams', c: ['✓', '✓', '✓'] },
  { f: 'Fail what-if', key: 'failWhatIf', c: ['✓', '✓', '✓'] },
  { f: 'Import report and checks', key: 'checks', c: ['✓', '✓', '✓'] },
  { f: 'Share image + rack-elevation PNG', key: 'shareImage', c: ['✓', '✓', '✓'] },
  { f: 'Download your lab as a file', key: 'downloadLab', c: ['✓', '✓', '✓'] },
  { f: 'Saved lab', key: 'savedLab', c: ['—', '✓', '✓'] },
  { f: 'History (simulated until the agent ships)', key: 'history', c: ['24 hours', '30 days', '1 year'] },
  { f: 'Read-only share link', key: 'shareLink', c: ['—', '✓', '✓'] },
  { f: 'Cabling view, traced through patch panels', key: 'cablingView', c: ['preview', 'preview', '✓'] },
  { f: 'AI view: tokens per second', key: 'aiTokensPerSecond', c: ['✓', '✓', '✓'] },
  { f: 'AI view: tokens per kWh, cost per 1M tokens, idle-GPU finder', key: 'aiTokensPerKwh', c: ['preview', 'preview', '✓'] },
  { f: 'Flaw Finder', key: 'flawFinder', c: ['one run', 'one run per lab', 'full, with fixes'] },
  { f: 'PDF report, Excel export', key: 'pdfExport', c: ['—', '—', '✓'] },
  { f: 'Upgrade Planner (what-if with cost)', key: 'upgradePlanner', c: ['—', '—', '✓'] },
  { f: 'Alerts', key: 'alerts', c: ['—', '—', '✓'] },
  { f: 'Agent: finds your devices', key: 'agent', c: ['this session', 'unattended', 'unattended'] },
];
const soon = !FLAGS.billingLive;
---
<Base title={`Pricing: Free, $${PRICES.account.month}/month or $${PRICES.pro.month}/month | ${PRODUCT_NAME}`}
  description={`Try is free with no account and nothing stored. Account keeps your lab for $${PRICES.account.month}/month or $${PRICES.account.year}/year. Pro adds cable tracing, the AI view and more.`}
  path="/pricing" ogImage="/og/pricing.png">
  <section class="section-tight">
    <div class="wrap">
      <h1>Pricing</h1>
      <p class="lead">Start free. Pay only when you want {PRODUCT_NAME} to keep your lab.</p>
      <p class="muted">No account = we store nothing. $5/month keeps it.</p>
      <div class="grid grid-3 plans">
        <div class="card">
          <h2>Try</h2><p class="price">Free</p><p class="muted"><em>No account · nothing stored</em></p>
          <ul><li>1–2 racks in 3D from your spreadsheet</li><li>Power, Heat, Network, Compute views</li><li>Power and network diagrams with <strong>Fail</strong> what-if</li><li>Import report and checks</li><li>Share image and rack-elevation PNG</li><li>One Flaw Finder run</li><li>Closes with the tab, or download your lab as a file</li></ul>
          <TryButton label="Try it free" />
        </div>
        <div class="card featured">
          <h2>Account {soon && <span class="pill pill-soon">Launching soon</span>}</h2>
          <p class="price">${PRICES.account.month} <span>/ month</span></p><p class="muted">or ${PRICES.account.year} / year, two months free</p>
          <p class="small muted">Everything in Try, plus:</p>
          <ul><li>Your lab saved (up to 2 racks)</li><li>30-day history</li><li>A read-only share link to your rack</li><li>Device catalog updates</li></ul>
          {soon ? <a class="btn btn-ghost" href={mailto(`${PRODUCT_NAME}: tell me when Account opens`, 'One e-mail when Account and Pro open, please.')}>E-mail me when it opens</a> : <a class="btn btn-primary" href="#">Get Account</a>}
        </div>
        <div class="card">
          <h2>Pro {soon && <span class="pill pill-soon">Launching soon</span>}</h2>
          <p class="price">${PRICES.pro.month} <span>/ month</span></p><p class="muted"><em>Explains your lab</em></p>
          <p class="small muted">Everything in Account, plus:</p>
          <ul><li>Up to 4 racks, 1-year history</li><li>Cabling view: every cable traced end to end</li><li>AI view: tokens per kWh, cost per million tokens</li><li>Flaw Finder: every single point of failure, ranked, with the fix</li><li>PDF report and Excel export</li><li>Upgrade Planner <span class="pill pill-roadmap">Roadmap</span></li></ul>
          {soon ? <a class="btn btn-ghost" href={mailto(`${PRODUCT_NAME}: tell me when Pro opens`, 'One e-mail when Pro opens, please.')}>E-mail me when it opens</a> : <a class="btn btn-primary" href="#">Get Pro</a>}
          <p class="small muted" style="margin-top:10px">For the small office or MSP with up to four racks, too.</p>
        </div>
      </div>
      {soon && <p class="small muted" style="margin-top:12px">The e-mail link opens your mail app; we answer once, when Account and Pro open. No list.</p>}
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <h2>Compare plans</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Feature</th><th>Try</th><th>Account</th><th>Pro</th></tr></thead>
          <tbody>
            {rows.map((r) => (
              <tr><td>{r.f} {FEATURE_STATUS[r.key] === 'roadmap' && <span class="pill pill-roadmap">Roadmap</span>}</td>
                {r.c.map((c) => <td>{c}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small muted">"Preview" = the feature opens with its numbers blurred and an upgrade card. Roadmap items are planned, not shipped.</p>
    </div>
  </section>

  <section class="section"><div class="wrap narrow"><Faq items={pricingFaq} /></div></section>
</Base>
<style>
  .plans { margin-top: 24px; }
  .plans h2 { font-size: 1.3rem; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .price { font-size: 2rem; font-weight: 750; margin: 0; }
  .price span { font-size: 1rem; color: var(--muted); font-weight: 400; }
  .plans ul { padding-left: 1.1em; margin: 0 0 18px; }
  .plans li { margin: .35em 0; }
  .featured { border-color: rgba(56,189,248,.5); }
  td:not(:first-child), th:not(:first-child) { text-align: center; white-space: nowrap; }
</style>
