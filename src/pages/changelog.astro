---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { u } from '../lib/url';
import { PRODUCT_NAME } from '../config/brand';
const entries = (await getCollection('changelog')).sort((a, b) => +b.data.date - +a.data.date);
const rendered = await Promise.all(entries.map(async (e) => ({ e, C: (await render(e)).Content })));
---
<Base title={`Changelog | ${PRODUCT_NAME}`} description={`What's new in ${PRODUCT_NAME}, newest first: features shipped, fixes and what's coming to your 3D homelab rack.`} path="/changelog" ogImage="/og/home.png">
  <section class="section-tight">
    <div class="wrap narrow">
      <h1>Changelog</h1>
      <p class="lead">What's new in {PRODUCT_NAME}, newest first. Subscribe with <a href={u('/changelog.xml')}>RSS</a>.</p>
      {rendered.map(({ e, C }) => (
        <article class="entry prose" id={e.id}>
          <p class="small muted"><time datetime={e.data.date.toISOString().slice(0, 10)}>{e.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time></p>
          <h2>{e.data.title}</h2>
          <C />
        </article>
      ))}
    </div>
  </section>
</Base>
<style>.entry { border-top: 1px solid var(--line); padding-top: 24px; margin-top: 24px; } .entry h2 { margin-top: .2em; }</style>
