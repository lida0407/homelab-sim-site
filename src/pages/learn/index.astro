---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { u } from '../../lib/url';
const live = (await getCollection('learn')).sort((a, b) => +a.data.date - +b.data.date);
const isLive = (slug: string) => live.some((e) => e.data.slug === slug);
const calculators = [
  { t: 'Rack Density Calculator', d: 'How many devices fit before space, power or cooling runs out.', href: '/calculator', live: true },
  { t: 'Tokens per Watt Calculator', d: 'Tokens per kWh and cost per million tokens for your home AI box.', href: '/learn/tokens-per-watt', live: isLive('tokens-per-watt') },
  { t: 'Homelab Power Cost Calculator', d: 'What your whole lab costs per month, device by device.', href: '/learn/homelab-power-calculator', live: isLive('homelab-power-calculator') },
  { t: '10-inch Rack Planner', d: 'Will it fit? Width, depth and U for a 10-inch mini rack.', href: '/learn/10-inch-mini-rack-planner', live: isLive('10-inch-mini-rack-planner') },
  { t: 'Idle Savings & Payback', d: 'What a lower idle draw or a new box saves, and when it pays back.', href: '/learn/proxmox-power-usage', live: isLive('proxmox-power-usage') },
  { t: 'UPS Runtime Calculator', d: 'How long your UPS keeps the lab up, and how big a UPS you need.', href: '/learn/ups-runtime-calculator', live: isLive('ups-runtime-calculator') },
];
const upcoming = [
  { t: 'How much power does a homelab use?', d: 'From 10–20 W for one mini PC to 300–900 W for a rack of used enterprise servers.' },
  { t: 'Rack diagram from Excel', d: 'One row per device (rack, U, model) gives a rack elevation and a 3D view.' },
  { t: 'Homelab rack layout', d: 'Network at the top, heavy gear and the UPS at the bottom, room left to grow.' },
  { t: 'Homelab cable management plan', d: 'Keep patch panel and switch together, label both ends, keep the port map in a sheet.' },
];
---
<Base title="Homelab Guides & Free Calculators | RACKDENSITY"
  description="Free homelab calculators and guides: power cost, tokens per watt, 10-inch mini racks, UPS runtime, Proxmox power usage and rack layout."
  path="/learn" ogImage="/og/learn.png">
  <section class="section-tight">
    <div class="wrap">
      <h1>Learn</h1>
      <p class="lead">Straight answers for planning, powering and running a homelab rack. Each guide comes with a calculator, and a way to see the result on your own rack in 3D.</p>
      <h2 style="margin-top:1.5em">Free calculators</h2>
      <div class="grid grid-3">
        {calculators.map((c) => c.live
          ? <a class="card link" href={u(c.href)}><span class="pill pill-ok">Calculator</span><h3>{c.t}</h3><p class="muted">{c.d}</p></a>
          : <div class="card"><span class="pill">Coming soon</span><h3>{c.t}</h3><p class="muted">{c.d}</p></div>)}
      </div>
      <h2 style="margin-top:1.8em">Guides</h2>
      <div class="grid grid-2">
        {live.map((e) => <a class="card link" href={u(`/learn/${e.data.slug}`)}><h3>{e.data.title}</h3><p class="muted">{e.data.teaser}</p></a>)}
        {upcoming.map((g) => <div class="card"><span class="pill">Coming soon</span><h3>{g.t}</h3><p class="muted">{g.d}</p></div>)}
      </div>
      <p style="margin-top:24px">Have a rack already? <a href={u('/try')}>See it in 3D, free →</a></p>
    </div>
  </section>
</Base>
<style>
  .link { text-decoration: none; color: var(--text); display: block; transition: border-color .15s; }
  .link:hover { border-color: var(--accent); color: var(--text); }
  .card h3 { margin-top: .6em; }
</style>
