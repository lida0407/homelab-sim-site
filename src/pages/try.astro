---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import Faq from '../components/Faq.astro';
import TryButton from '../components/TryButton.astro';
import { u } from '../lib/url';
import { PRODUCT_NAME, TRY, FLAGS, PRICES } from '../config/brand';
import { tryFaq } from '../data/faq';
import overview from '../assets/shots/overview.png';
import flaw from '../assets/shots/flaw-finder.png';
import viewMenu from '../assets/shots/view-menu.png';
import phone from '../assets/shots/phone.png';
---
<Base title={`Try ${PRODUCT_NAME} Free: Your Rack in 3D, No Account`}
  description="Open the demo lab or drop in your own Excel or CSV. Your homelab rack in 3D with power, network and a Fail what-if. Free, nothing stored."
  path="/try" ogImage="/og/try.png">
  <section class="section-tight">
    <div class="wrap">
      <h1>Try {PRODUCT_NAME}</h1>
      <p class="lead">Start with the demo lab, then add your own. No account, and nothing is stored.</p>
      <div class="btn-row">
        <TryButton direct label="Open the app ↗" utm="try-page" />
        {!TRY.live && <span class="muted small">The public app opens {TRY.comingNote}. Until then: screenshots below, and the template is ready to fill in.</span>}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap grid grid-2">
      <Shot src={overview} eager alt="The demo lab in 3D with the Try banner: nothing is saved, close the tab and it's gone" sizes="(min-width: 760px) 560px, 100vw" />
      <Shot src={flaw} alt="Flaw Finder in Try: the UPS is a single point of failure; 14 devices would go dark" sizes="(min-width: 760px) 560px, 100vw" />
      <Shot src={viewMenu} alt="The View menu: Overview, Power, Heat, Network, Cables, Compute, AI" sizes="(min-width: 760px) 560px, 100vw" />
      <div class="phone"><Shot src={phone} alt="The demo lab on a phone-sized screen (emulated)" caption="Demo lab · simulated data · phone layout (emulated, not yet tested on real devices)" widths={[390, 780]} sizes="320px" /></div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap btn-row">
      <a class="btn btn-ghost" href={u('/downloads/homelab-template.xlsx')} download>Download the template (.xlsx)</a>
      <a class="btn btn-ghost" href={u('/downloads/basement-lab.xlsx')} download>Download the Basement Lab example</a>
      <a href="#steps">How to fill it in ↓</a>
    </div>
  </section>

  <section class="section" id="steps">
    <div class="wrap narrow prose">
      <h2>Your lab in three steps</h2>
      <ol>
        <li><strong>Download the template.</strong> It has one sheet per topic: Devices, Cables, Racks, Power, Networks, Readings.</li>
        <li><strong>Fill in Devices.</strong> One row per device, with rack, U (the lowest unit it sits in) and model. Leave U empty for gear outside the rack, such as access points, cameras or the ISP box. The other sheets are optional: Cables adds the network and cable views, Power adds the power chain, Readings fits the numbers to your real measurements.</li>
        <li><strong>Open ⋯ → Add your lab and drop the file.</strong> .xlsx, or one CSV per sheet. You get an import report: rows imported, rows skipped with the reason, and checks pinned on the rack. Then enter your electricity price.</li>
      </ol>
      <h2>What the import checks</h2>
      <p>Two devices in one U · a port used twice · 10G on a 1G port or fiber into RJ45 · both power supplies on one feed · a power strip over 80 % · UPS runtime under 5 minutes · a cable shorter than its run · missing labels · undefined VLANs · port errors · cable ends that name an unknown device.</p>
      <h2>Close the tab and it's gone</h2>
      <p>Try keeps your lab in this browser tab only: no cookies, no browser storage, nothing sent to a server. Close the tab and the lab is gone; we never had it. Want to come back to it? Download your lab as a file and import it next time.{FLAGS.billingLive ? ` Or let an Account ($${PRICES.account.month}/month) keep it.` : ' Accounts that keep your lab are launching soon.'}</p>
    </div>
  </section>

  <section class="section"><div class="wrap narrow"><Faq items={tryFaq} /></div></section>
</Base>
<style>
  .phone { max-width: 320px; justify-self: center; }
</style>
