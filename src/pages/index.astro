---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import Faq from '../components/Faq.astro';
import TryButton from '../components/TryButton.astro';
import { u, abs } from '../lib/url';
import { PRODUCT_NAME, PRICES, FLAGS, TRY } from '../config/brand';
import { homeFaq } from '../data/faq';
import overview from '../assets/shots/overview.png';
import viewMenu from '../assets/shots/view-menu.png';
import flaw from '../assets/shots/flaw-finder.png';
import cables from '../assets/shots/cables.png';
import ai from '../assets/shots/ai.png';
import report from '../assets/shots/import-report.png';

const app = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', '@id': abs('/') + '#app', name: PRODUCT_NAME,
  applicationCategory: 'UtilitiesApplication', operatingSystem: 'Web browser', url: abs('/try'),
  description: 'A 3D model of your homelab rack built from an Excel or CSV file: power and cost per device (estimated), heat, network and cable views, power and network diagrams, and a Fail what-if. The file is read in your browser and never uploaded.',
  offers: [{ '@type': 'Offer', name: 'Try', price: '0', priceCurrency: 'USD', description: 'Free, no account, nothing stored', url: abs('/try') }] };
const views = [
  { id: 'overview', label: 'Overview', img: overview, alt: 'The demo lab in 3D: two racks with labelled devices, a power and cost readout at the top and the timeline at the bottom', text: 'The whole lab at a glance: racks, devices, and the gear outside the rack. One readout on top: watts, cost per month, UPS runtime.' },
  { id: 'views', label: 'Views', img: viewMenu, alt: 'The View menu open over the demo lab, listing Overview, Power, Heat, Network, Cables, Compute and AI', text: 'Overview, Power, Heat, Network, Cables, Compute and AI sit in one View menu (keys 1–7). Power and Network switch between 3D and a diagram.' },
  { id: 'flaws', label: 'Flaw Finder', img: flaw, alt: 'Flaw Finder panel over the demo lab: the UPS is a single point of failure, with the devices that go dark and the fix', text: 'Single points of failure, overloaded strips, UPS runtime at peak and more, ranked with the fix. Try runs it once and opens the first issue.' },
  { id: 'cables', label: 'Cables · Pro', img: cables, alt: 'Cables view: power and network cables drawn at the back of both racks, with a cable count per device', text: 'Every cable at the rear of the rack, coloured by type and traced end to end through patch panels.' },
  { id: 'ai', label: 'AI · Pro', img: ai, alt: 'AI view: tokens per second per AI box, with tokens per kWh blurred as a Pro preview', text: 'Tokens per second for the AI box in your rack; tokens per kWh and cost per million tokens on Pro.' },
];
---
<Base title={`3D Homelab Rack Planner: Power, Cost & Cables | ${PRODUCT_NAME}`}
  description="Turn a spreadsheet of your gear into a 3D model of your homelab rack: watts, cost per month, network, and what goes dark when one thing fails. Free."
  path="/" ogImage="/og/home.png" schema={[app]}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{PRODUCT_NAME} · free 3D rack planner</p>
        <h1>Your homelab rack, in&nbsp;3D.</h1>
        <p class="lead">Drop in a spreadsheet of your gear. See what every device draws and costs, what's plugged where, and what goes dark when one thing fails.</p>
        <div class="btn-row">
          <TryButton />
          <a href={u('/try#steps')}>or see how the import works →</a>
        </div>
        <p class="small muted" style="margin-top:14px">Your file is read in your browser and never uploaded.{!TRY.live && <> The app opens to the public {TRY.comingNote}.</>}</p>
      </div>
      <Shot src={overview} eager alt="The demo lab in 3D: two racks with labelled devices, 1 kW and €164 a month shown at the top" sizes="(min-width: 1000px) 620px, 100vw" />
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="chips" aria-label="Demo lab numbers">
        <span class="chip"><b style="color:var(--power)">1.01 kW</b> now</span>
        <span class="chip"><b style="color:var(--power)">€164</b> / month</span>
        <span class="chip"><b style="color:var(--net)">19 min</b> on UPS</span>
        <span class="chip"><b style="color:var(--heat)">16 issues</b> found</span>
      </div>
      <p class="small muted" style="margin-top:8px">From the Basement Lab demo · simulated data</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid-3">
      <div class="card"><h3 style="color:var(--power)">What it costs</h3><p>Watts per device and money per month at your electricity price, estimated from each model and any readings you add. Follow the power from the wall through the UPS and power strip to every device, with the load on each step.</p></div>
      <div class="card"><h3 style="color:var(--net)">What's plugged where</h3><p>Router to switch to device, port by port, in 3D or as a clean diagram. On Pro, trace every cable at the back of the rack from end to end, through the patch panel.</p></div>
      <div class="card"><h3 style="color:var(--heat)">What goes dark</h3><p>Click the UPS, a power strip or a switch and press <strong>Fail</strong>. {PRODUCT_NAME} shows what loses power or network, and what keeps running. In every plan.</p></div>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap">
      <h2>From spreadsheet to 3D rack, in your browser.</h2>
      <ol class="steps grid grid-3">
        <li class="card"><h3>1. Get the template</h3><p>Or start from the Basement Lab example.</p></li>
        <li class="card"><h3>2. Fill in Devices</h3><p>Rack, U and model are the only required columns. Add cables, power and readings when you want more.</p></li>
        <li class="card"><h3>3. Drop the file in</h3><p>You get an import report and your rack in 3D. Unknown models still show up, as plain boxes of the right height.</p></li>
      </ol>
      <div class="btn-row" style="margin-top:18px">
        <a class="btn btn-ghost" href={u('/downloads/homelab-template.xlsx')} download>Download the template (.xlsx)</a>
        <a class="btn btn-ghost" href={u('/downloads/basement-lab.xlsx')} download>Download the Basement Lab example</a>
      </div>
      <p class="small muted" style="margin-top:10px">.xlsx, or one CSV per sheet. The file never leaves your machine.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>One rack, seen several ways.</h2>
      <div class="viewtabs">
        {views.map((v, i) => <input type="radio" name="view" id={`v-${v.id}`} checked={i === 0} class="sr-only" />)}
        <div class="tablist" role="presentation">{views.map((v) => <label for={`v-${v.id}`}>{v.label}</label>)}</div>
        {views.map((v) => <div class={`panel p-${v.id}`}><p class="muted">{v.text}</p><Shot src={v.img} alt={v.alt} /></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid-2" style="align-items:center">
      <div>
        <h2>It reads your sheet like a second pair of eyes.</h2>
        <p>Every import ends with a report: rows imported, rows skipped (with the reason), and checks pinned on the rack.</p>
        <ul class="checks">
          <li>Two devices in the same U</li><li>A port used twice</li><li>10G on a 1G port, or fiber into RJ45</li><li>Both power supplies on the same feed</li>
          <li>A power strip over 80 % of its rating</li><li>UPS runtime under 5 minutes</li><li>A cable shorter than its run</li><li>Missing labels, undefined VLANs, port errors</li>
        </ul>
      </div>
      <Shot src={report} alt="Import report of the template file: sheets imported, checks with errors, warnings and notes" sizes="(min-width: 760px) 540px, 100vw" />
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid-2">
      <div class="card">
        <h2>Post your rack.</h2>
        <p>Every lab gets a ready-made share image (1200×630) and a clean rack-elevation PNG. Download them and drop them in your next r/homelab post.</p>
      </div>
      <div class="card ai-band">
        <h2>Tokens per kWh, for the AI box in your rack.</h2>
        <p>Tokens per second tells you how fast it is. Tokens per kWh tells you what it costs. {PRODUCT_NAME} puts both on the rack, next to the watts.</p>
        <p><a href={u('/learn/tokens-per-watt')}>Work out your tokens per watt with the free calculator →</a></p>
        <p class="small muted">The AI view's tokens per kWh is part of Pro. The calculator is free.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Pricing</h2>
      <div class="grid grid-3">
        <div class="card"><h3>Try · Free</h3><p class="muted">No account, nothing stored.</p></div>
        <div class="card"><h3>Account · ${PRICES.account.month}/month {!FLAGS.billingLive && <span class="pill pill-soon">Launching soon</span>}</h3><p class="muted">or ${PRICES.account.year}/year. Keep your lab.</p></div>
        <div class="card"><h3>Pro · ${PRICES.pro.month}/month {!FLAGS.billingLive && <span class="pill pill-soon">Launching soon</span>}</h3><p class="muted">Cables, AI and the full toolkit.</p></div>
      </div>
      <p style="margin-top:14px"><a href={u('/pricing')}>Compare plans →</a></p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap narrow">
      <p class="lead"><strong>Built by data-center people.</strong> {PRODUCT_NAME} comes from a team that builds 3D models of full data centers, scaled down to the rack in your basement. In partnership with <a href="https://sensaka.com" rel="noopener">Sensaka</a>.</p>
    </div>
  </section>

  <section class="section"><div class="wrap narrow"><Faq items={homeFaq} /></div></section>

  <section class="section final">
    <div class="wrap center">
      <h2>See your rack in 3D.</h2>
      <div class="btn-row" style="justify-content:center"><TryButton /></div>
      <p class="muted" style="margin-top:14px">No account = we store nothing. $5/month keeps it.</p>
    </div>
  </section>
</Base>
<style>
  .hero { padding: 48px 0 24px; background: radial-gradient(900px 400px at 75% 0%, rgba(56,189,248,.13), transparent 70%); }
  .hero-grid { display: grid; gap: 28px; align-items: center; }
  @media (min-width: 1000px) { .hero-grid { grid-template-columns: 1fr 1.15fr; } .hero { padding: 72px 0 32px; } }
  .steps { list-style: none; padding: 0; margin: 0; }
  .checks { columns: 1; padding-left: 1.2em; }
  @media (min-width: 640px) { .checks { columns: 2; } }
  .checks li { margin: .35em 0; break-inside: avoid; }
  .ai-band { border-color: rgba(167,139,250,.4); background: linear-gradient(135deg, rgba(167,139,250,.12), transparent); }
  .final { background: radial-gradient(700px 300px at 50% 100%, rgba(56,189,248,.12), transparent 70%); }
  .tablist { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
  .tablist label { cursor: pointer; padding: 8px 14px; border: 1px solid var(--line2); border-radius: 9px; color: var(--muted); font-size: .92rem; min-height: 40px; display: inline-flex; align-items: center; }
  .panel { display: none; }
  #v-overview:checked ~ .p-overview, #v-views:checked ~ .p-views, #v-flaws:checked ~ .p-flaws, #v-cables:checked ~ .p-cables, #v-ai:checked ~ .p-ai { display: block; }
  #v-overview:checked ~ .tablist label[for='v-overview'], #v-views:checked ~ .tablist label[for='v-views'], #v-flaws:checked ~ .tablist label[for='v-flaws'],
  #v-cables:checked ~ .tablist label[for='v-cables'], #v-ai:checked ~ .tablist label[for='v-ai'] { color: var(--text); border-color: var(--accent); background: rgba(56,189,248,.12); }
  .viewtabs input:focus-visible ~ .tablist label { outline: none; }
  #v-overview:focus-visible ~ .tablist label[for='v-overview'], #v-views:focus-visible ~ .tablist label[for='v-views'], #v-flaws:focus-visible ~ .tablist label[for='v-flaws'],
  #v-cables:focus-visible ~ .tablist label[for='v-cables'], #v-ai:focus-visible ~ .tablist label[for='v-ai'] { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
