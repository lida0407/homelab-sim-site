---
// Every "Try" call to action. While TRY.live is false it goes to /try (screenshots + "coming this week").
import { u } from '../lib/url';
import { TRY } from '../config/brand';
interface Props { label?: string; direct?: boolean; utm?: string }
const { label = 'Try it free, no account', direct = false, utm } = Astro.props;
const appUrl = TRY.url + (utm ? `?utm_source=${utm}&utm_medium=site` : '');
---
{direct
  ? (TRY.live
      ? <a class="btn btn-primary" href={appUrl} rel="noopener">{label}</a>
      : <span class="btn btn-primary" aria-disabled="true" role="link">Try: {TRY.comingNote}</span>)
  : <a class="btn btn-primary" href={u('/try')}>{label}</a>}
