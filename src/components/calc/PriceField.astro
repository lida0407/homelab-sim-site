---
interface Props { label?: string }
const { label = 'Electricity price' } = Astro.props;
---
<div class="field">
  <span>{label}</span>
  <div style="display:flex; gap:8px">
    <select data-currency aria-label="Currency" style="max-width:5.5em">
      <option value="€">€</option><option value="$">$</option><option value="£">£</option>
    </select>
    <input data-price type="number" inputmode="decimal" min="0" step="0.01" value="0.30" aria-label="Price per kWh" />
  </div>
  <span class="hint">per kWh: use the price on your bill</span>
</div>
