---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; eager?: boolean; widths?: number[]; sizes?: string }
const { src, alt, caption = 'Demo lab · simulated data', eager = false, widths = [480, 800, 1200], sizes = '(min-width: 1160px) 1120px, 100vw' } = Astro.props;
---
<figure class="shot">
  <Image src={src} alt={alt} widths={widths} sizes={sizes} format="webp" quality={72}
    loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding={eager ? 'sync' : 'async'} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
